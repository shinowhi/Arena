# Meta Model API (server only -- never expose to the client)
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
MODEL_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: used by lib/supabase/service.ts for admin RPCs. Copy from the
# Supabase dashboard API settings. NEVER prefix with NEXT_PUBLIC_ and never
# commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Cron warmer + admin dashboard (P1 backend; set real values in .env.local)
CRON_SECRET=
ADMIN_SECRET=

# Signed anonymous-identity cookie (server only -- never expose to the client).
# REQUIRED in production (lib/game/player-sign.ts throws without it when
# NODE_ENV=production); dev falls back to MODEL_API_KEY, else an ephemeral
# boot secret (cookies invalidate on restart). Use a long random string.
PLAYER_SECRET=

# Game tuning (demo values)
BOSS_TTL_SECONDS=240
WORLD_BOSS_HP=200
RUSH_BOSS_HP=2000
